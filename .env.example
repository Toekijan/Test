# De Ruimtelijke Plannen API (data.informatiehuisruimte.nl) die de app gebruikt om
# regels op een locatie op te zoeken, lijkt volgens de officiele PDOK OpenAPI-spec
# zonder API-key te werken. Zet deze alleen als de live API toch 401/403 teruggeeft:
# https://developer.omgevingswet.overheid.nl/formulieren/api-key-aanvragen-0/
DSO_API_KEY=

# Optioneel: overschrijf als de basis-URL afwijkt van wat in de spec staat
# (zie lib/dso.ts voor uitleg en bron).
# DSO_BASE_URL=https://data.informatiehuisruimte.nl/api/ruimtelijke-plannen/v1

# Optioneel maar sterk aanbevolen: zonder deze key wordt er geen inhoudelijke
# AI-redenering over de opgehaalde regeltekst uitgevoerd, alleen een trefwoord-vangnet.
ANTHROPIC_API_KEY=

# Optioneel: pas de kaartlaag met bestemmingsplan-contouren aan als de standaard
# WMS-service/laagnaam van PDOK/ruimtelijkeplannen.nl bij jou anders blijkt te zijn.
# NEXT_PUBLIC_RP_WMS_URL=https://service.pdok.nl/kadaster/ruimtelijkeplannen/wms/v1_0
# NEXT_PUBLIC_RP_WMS_LAYER=Bestemmingsplangebied
